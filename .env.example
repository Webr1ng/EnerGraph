# ============================================================
# LLM Provider (选哪个填哪个，未选的注释掉即可)
# ============================================================
LLM_PROVIDER=deepseek           # deepseek | modelscope | openai | anthropic

# --- DeepSeek（官方 API）---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
# deepseek-v4-pro   → DeepSeek-V4 旗舰版 (1.6T/49B, 1M上下文)
# deepseek-v4-flash → DeepSeek-V4 轻量版 (284B/13B, 1M上下文)

# --- ModelScope（魔搭免费 API，兼容 OpenAI，可跑 DeepSeek-V4-Flash 等）---
# 切换：把上方 LLM_PROVIDER 改为 modelscope，并填下方 token
# MODELSCOPE_API_KEY=your_modelscope_token_here   # ms- 开头，modelscope.cn 个人中心申请
# MODELSCOPE_MODEL=deepseek-ai/DeepSeek-V4-Flash  # 魔搭模型库 model-id
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Local vLLM（内网部署的本地推理服务，兼容 OpenAI API）---
# 切换：LLM_PROVIDER=local，确保 vLLM 服务已启动在 LOCAL_BASE_URL
# llm.py 自动识别模型系列：
#   qwen3 / qwen3.5 / qwen3.6 / qwen3- → 关 enable_thinking
#   其他模型 → 不加 model_kwargs（GGUF 量化版通过 vLLM 自动识别）
# 换模型只需改 LOCAL_MODEL 一行，无需改代码：
#   Qwen3.6：qwen3.6-8b / qwen3.6-35b-a3b / qwen3.6-72b …
#   Qwen3.5：qwen3.5-122b-a10b / qwen3.5-32b …
#   Qwen2.5：qwen2.5-7b / qwen2.5-14b / qwen2.5-32b / qwen2.5-72b …
#   其他：deepseek-v3 / llama-3 …
# GGUF 量化版指定方式（vLLM 启动时用 --served-model-name 命名）：
#   vllm serve ./Qwen3.5-122B-A10B-Q5_K_M.gguf --served-model-name qwen3.5-122b-a10b
#   vllm serve ./Qwen3.6-35B-A3B-Q5_K_M.gguf --served-model-name qwen3.6-35b-a3b
# MODEL 填 vLLM 的 served-model-name 即可，无需加路径或 .gguf 后缀
#
# LOCAL_TIMEOUT: 超大模型专用超时秒数（122B MoE 建议 ≥120；不设则用 langchain 默认）
# LOCAL_EXTRA_KWARGS: JSON 一次性覆盖（不碰代码调参），例：'{"max_tokens":4096}'
#   ChatOpenAI 支持的关键词见 langchain 文档；JSON 不合法时静默忽略不动默认行为
#
# LLM_PROVIDER=local
# LOCAL_MODEL=qwen3.6-27b
# LOCAL_BASE_URL=http://localhost:8001/v1
# LOCAL_API_KEY=not-needed
# LOCAL_TIMEOUT=120
# LOCAL_EXTRA_KWARGS='{"request_timeout":120,"max_tokens":4096}'

# ============================================================
# Application Settings
# ============================================================
AGENT_TEMPERATURE=0.7
AGENT_MAX_ITERATIONS=10
DEBUG=false
LOG_LEVEL=INFO

# RAG embedding 默认仅从本地 Hugging Face 缓存加载，避免运行时联网检查阻塞。
# 首次部署、确实需要下载 BAAI/bge-small-zh-v1.5 时临时改为 false，下载完成后恢复 true。
RAG_EMBEDDING_LOCAL_FILES_ONLY=true

# ============================================================
# Agent API 服务配置（暴露给前端同事的 HTTP 接口）
# ============================================================
API_HOST=0.0.0.0                # 监听地址，0.0.0.0 = 所有网卡
API_PORT=8000                   # 监听端口
API_CORS_ORIGINS=*              # CORS 允许的前端域名，逗号分隔。生产环境应改为: https://aiot-fuca.com
API_KEY=                        # API 鉴权密钥。空 = 不启用（开发模式），填值后前端需带 Authorization: Bearer <key>

# ============================================================
# 福加 API 配置（真实接口，对接福加能碳管理平台）
# ============================================================
FUCA_API_BASE_URL=https://aiot-fuca.com
# Token 由自动刷新机制管理，也可手动填写（过期后自动刷新覆盖）
FUCA_API_TOKEN=your_fuca_token_here
FUCA_TENANT_ID=1071
# Token 自动刷新凭据（配置后 401 时自动登录刷新 Token）
FUCA_LOGIN_NAME=your_fuca_login_name
FUCA_PASSWORD=your_fuca_password

# ============================================================
# 记忆模块配置（L1 checkpoint + L2 长期记忆，共用 PostgreSQL）
# ============================================================
MEMORY_ENABLED=false
# 启用 MEMORY_ENABLED 或 MEMORY_USE_POSTGRES_STORE 时必须替换为当前环境真实配置
MEMORY_POSTGRES_DSN=postgresql://<username>:<password>@<host>:5432/<database>
LANGGRAPH_STRICT_MSGPACK=true
CHECKPOINT_TABLE=checkpoints
STORE_TABLE=store
MEMORY_NAMESPACE_PREFIX=energraph
MEMORY_ENV=dev
MEMORY_DEFAULT_SITE_ID=local
MEMORY_DEFAULT_AGENT_ID=main_graph
MEMORY_DEFAULT_TTL_SECONDS=0
MEMORY_AUTO_EXTRACT_ENABLED=false
MEMORY_EXTRACT_MIN_CONFIDENCE=0.65
MEMORY_MAX_MEMORIES_PER_TURN=3
MEMORY_DEVICE_STATE_DEFAULT_TTL_SECONDS=86400
MEMORY_USE_POSTGRES_STORE=false
MEMORY_POSTGRES_POOL_MIN_SIZE=1
MEMORY_POSTGRES_POOL_MAX_SIZE=10
MEMORY_POSTGRES_SETUP_ENABLED=false
# Demo only: L2 InMemory fallback 落盘到 data/long_term_memory_demo/memories.json，便于人工测试重启后复查
MEMORY_DEMO_FILE_STORE_ENABLED=false
MEMORY_DEMO_FILE_STORE_PATH=data/long_term_memory_demo/memories.json
